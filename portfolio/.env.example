# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/portfolio
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/portfolio

# JWT — change this to a long random string in production!
JWT_SECRET=change_this_to_a_random_secret_in_production

# CORS — production URL of your deployed client
CLIENT_URL=http://localhost:5173

# ── Email (optional — contact form notifications) ─────────────────────────────
# Leave blank to disable email notifications; messages still save to DB.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
CONTACT_EMAIL=your@gmail.com   # where to receive contact messages

# ── GitHub Stats (optional — live data) ───────────────────────────────────────
# Leave blank to use the curated static data.
GITHUB_USERNAME=alexjohnson
GITHUB_TOKEN=ghp_your_personal_access_token

# ── Client ────────────────────────────────────────────────────────────────────
# Only needed if running client separately (not using Vite proxy)
VITE_API_URL=http://localhost:5000/api
